{
  "name": "dinefor-server",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node --dns-result-order=ipv4first server.js",
    "server": "nodemon server.js",
    "dev": "node --dns-result-order=ipv4first ./node_modules/nodemon/bin/nodemon.js server.js",
    "reminders": "node scripts/run-booking-reminders.js",
    "smtp:test": "node --dns-result-order=ipv4first scripts/test-email.js",
    "maintenance": "node --dns-result-order=ipv4first scripts/run-release2-maintenance.js",
    "seo:backfill-slugs": "node scripts/backfill-seo-slugs.js",
    "payments:expire": "node scripts/run-payment-expiry.js",
    "validate:release-4.5": "node scripts/validate-release-4-5.js",
    "payments:migrate-4.5": "node scripts/migrate-release-4-5-payments.js",
    "finance:migrate-4.6": "node scripts/migrate-release-4-6-finance.js",
    "validate:release-4.6": "node scripts/validate-release-4-6.js",
    "lifecycle:migrate-4.7": "node scripts/migrate-release-4-7-lifecycle.js",
    "validate:release-4.7": "node scripts/validate-release-4-7.js",
    "documents:migrate-4.8": "node scripts/migrate-release-4-8-documents.js",
    "validate:release-4.8": "node scripts/validate-release-4-8.js",
    "payments:migrate-4.9": "node scripts/migrate-release-4-9-monitoring.js",
    "validate:release-4.9": "node scripts/validate-release-4-9.js",
    "readiness:production": "node scripts/check-production-readiness.js"
  },
  "dependencies": {
    "bcryptjs": "latest",
    "compression": "^1.8.1",
    "cors": "latest",
    "dotenv": "latest",
    "express": "latest",
    "express-rate-limit": "^8.5.2",
    "google-auth-library": "^10.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "latest",
    "mongoose": "latest",
    "morgan": "latest",
    "multer": "latest",
    "nodemailer": "^7.0.5",
    "pdfkit": "^0.17.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
