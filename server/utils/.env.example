PORT=5000
MONGO_URI=your_mongodb_atlas_connection_string
JWT_SECRET=your_secret_key
CLIENT_URL=http://localhost:5173

PUBLIC_API_URL=https://api.dinefor.com
GOOGLE_CLIENT_ID=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=DineFor <no-reply@dinefor.com>

# Run `npm run reminders` every 5-10 minutes using cron/PM2 on production.
REMINDER_CRON=*/5 * * * *

# Release 2 communication finalization
ADMIN_ALERT_EMAIL=info@dinefor.com

# Run booking reminders every 5 minutes on production.
REMINDER_CRON=*/5 * * * *

# Run maintenance once per day on production.
MAINTENANCE_CRON=15 3 * * *

# Admin homepage hero uploads only. Keep ordinary uploads at the application default.
HERO_MEDIA_MAX_MB=500
