{
  "name": "dinefor",
  "version": "1.0.0",
  "description": "DineFor fullstack application",
  "scripts": {
    "start": "cd server && node server.js",
    "build": "cd client && npm install && npm run build && cd .. && mkdir -p dist && cp -r client/dist/* dist/",
    "server": "cd server && npm run dev",
    "client": "cd client && npm run dev"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}